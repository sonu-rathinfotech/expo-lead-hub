{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "VITE_BASE_PATH=/ pnpm build",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://elc-backend-gjfy.onrender.com/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
